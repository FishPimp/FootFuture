    <!-- Fotmätaren -->
    <string name="foot_subtitle">Mät foten direkt på skärmen</string>
    <string name="foot_calibration_title">1. Kalibrera skärmen</string>
    <string name="foot_calibrated">Kalibrerad: %1$s px/mm (≈ %2$d ppi)</string>
    <string name="foot_not_calibrated">Inte kalibrerad – använder skärmens uppgivna täthet (%1$s px/mm). Kalibrera för exakt mätning.</string>
    <string name="foot_calibrate_button">Kalibrera med kreditkort</string>
    <string name="foot_edge_offset">Kant till skärm: %1$s mm</string>
    <string name="foot_edge_offset_hint">Avståndet från mobilens nederkant (med skal) till skärmens första pixel. Mät med linjal.</string>
    <string name="foot_measure_title">2. Väggmetoden</string>
    <string name="foot_measure_steps">1. Lägg mobilen plant på golvet med nederkanten mot väggen.\n2. Låt barnet stå med hälen mot väggen och foten på skärmen.\n3. Dra linjen till spetsen av den längsta tån.</string>
    <string name="foot_measure_button">Starta mätning</string>
    <string name="foot_allowance_title">3. Skostorlek</string>
    <string name="foot_allowance">Växtmån: %1$d mm</string>
    <string name="foot_allowance_hint">Innerlängd = fot + växtmån. EU-storlek = innerlängd ÷ 6,67 mm. Vanlig rekommendation är 12–17 mm.</string>
    <string name="foot_allowance_example">Fot %1$d mm → stl %2$d</string>
    <string name="foot_latest">Senast för %1$s: %2$s mm (%3$s) → stl %4$d</string>
    <string name="foot_tips_title">💡 Tips</string>
    <string name="foot_tips">• Mät när barnet står upp – foten blir längre under belastning.\n• Mät båda fötterna och använd den längsta.\n• Mät gärna på eftermiddagen, då är fötterna som störst.</string>

